<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0"
          xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">

  <assemblyIdentity
      version="1.0.0.0"
      processorArchitecture="amd64"
      name="duwn.mirror"
      type="win32"/>

  <!--
    PerMonitorV2 DPI awareness:
    WM_SIZE lparam delivers physical pixels on every monitor.
    No DXGI scaling interference.
    Requires Win10 1703+.
  -->
  <asmv3:application>
    <asmv3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
        PerMonitorV2
      </dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>

  <!-- Supported Windows versions (for correct OS version in GetVersionEx / VerifyVersionInfo)
       Win10 and Win11 share one GUID: 8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a
       {1f676c76-80e1-4239-95bb-83d0f6d0da78} is Windows 8.1, not Windows 11. Do not list it. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

</assembly>
